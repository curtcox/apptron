--- a/boot.go
+++ b/boot.go
@@ -205,7 +205,13 @@
 	// Not only does it work in older Safari, but it's 50% faster than OPFS.
 	opfs := idbfs.New("apptron-rev1")
 	// opfs.SetLogger(log.Default())
-	if err := root.Namespace().Bind(opfs, ".", "web/idbfs/apptron"); err != nil {
+	// Keep the database private. This is the only persistent tree exposed to
+	// the guest, and its root is this snapshot, even after namespace rebinding.
+	snapshotPath := fmt.Sprintf("env/%s", envUUID)
+	if err := fs.MkdirAll(opfs, snapshotPath, 0755); err != nil { log.Fatal(err) }
+	snapshotFS, err := fs.Sub(opfs, snapshotPath)
+	if err != nil { log.Fatal(err) }
+	if err := root.Namespace().Bind(snapshotFS, ".", "snapshot-storage"); err != nil {
 		log.Fatal(err)
 	}
 

{
  "name": "apptron",
  "version": "1.0.0",
  "description": "Edit, boot, capture and share Apptron Linux snapshots on a static site",
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "test:boot": "APPTRON_BOOT=1 playwright test tests/browser/boot.spec.cjs --project=chromium",
    "build": "node scripts/package-site.mjs",
    "test:urls": "node tests/browser/url-state.cjs",
    "check": "node scripts/check.mjs",
    "gallery": "node scripts/gallery-catalog.mjs && node scripts/render-kit-gallery.mjs",
    "offline": "node scripts/update-offline.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/curtcox/apptron.git"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "bugs": {
    "url": "https://github.com/curtcox/apptron/issues"
  },
  "homepage": "https://github.com/curtcox/apptron#readme",
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "ace-builds": "1.43.3",
    "fake-indexeddb": "6.2.4",
    "lz-string": "1.5.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.12"
  }
}
